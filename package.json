{
  "name": "moonds-variables",
  "version": "1.0.0",
  "author": "Mario Hernandez",
  "description": "Moon DS Variables",
  "main": "code.js",
  "scripts": {
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "build": "npm run build:parcel && npm run build:code",
    "build:code": "tsc -p tsconfig.json",
    "watch:code": "npm run build:code -- --watch",
    "clean:parcel": "rm -rf ./.parcel-cache",
    "build:parcel": "npm run clean:parcel && parcel build ./plugin_ui/index.html --dist-dir dist/plugin_ui/",
    "watch:parcel": "npm run build:parcel && parcel watch ./plugin_ui/index.html --dist-dir dist/plugin_ui/"
  },
  "license": "MIT License",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "parcel": "^2.15.2",
    "typescript": "^5.3.2"
  },
  "targets": {
    "main": false
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
